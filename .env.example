# GEMINI_API_KEY: Required for Gemini AI API calls.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# GOOGLE_SHEET_ID: The Spreadsheet ID for the product verification sheet.
GOOGLE_SHEET_ID=DEFAULT_GOOGLE_SHEET_ID

# GOOGLE_SHEET_NAME: Worksheet tab name. Default: "Label Verification Data" or "Sheet1"
GOOGLE_SHEET_NAME=Label Verification Data

# GOOGLE_API_KEY: Optional Google Cloud API Key enabled for Google Sheets API v4
GOOGLE_API_KEY=DEFAULT_GOOGLE_API_KEY

